# Cloudflare static-asset headers (copied into build/ by SvelteKit).
# Files under /_app/immutable/ have content hashes in their names, so they never
# change: let browsers cache them for a year. HTML keeps the default
# (revalidate), so a new deploy shows up immediately.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
